# Copy to .env and fill in real values. .env is gitignored; never commit keys.
#
# LLM provider: local | openai | anthropic | gemini
LLM_PROVIDER=local

# Gemini (generativelanguage.googleapis.com). Retired models such as
# gemini-2.0-flash / gemini-2.5-flash are rejected with 404 for new users.
# Known-working as of this project: gemini-3.5-flash, gemini-3.6-flash,
# gemini-3-flash-preview, gemini-3.1-flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

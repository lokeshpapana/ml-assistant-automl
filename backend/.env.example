# App
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database (SQLite default = fully offline; switch to Postgres to use one)
DATABASE_URL=sqlite+aiosqlite:///./automl_app.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100

# ML
EXPERIMENT_TIMEOUT_SECONDS=300
MAX_CONCURRENT_EXPERIMENTS=3

# Redis (only for the optional Celery path)
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== Interactive AutoML & Multi-Agent Engine =====
AUTOML_OUTPUT_DIR=./automl_outputs

# Single source of truth dataset store (DuckDB preferred)
CENTRAL_STORE_PATH=./automl_outputs/central_store.duckdb
CENTRAL_STORE_IN_MEMORY=false

# MLflow (local file tracking, no cloud)
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=interactive_automl

# Core LLM provider: local (default, no keys) | openai | anthropic
LLM_PROVIDER=local
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Paper research & knowledge retrieval (HTTP-based, offline bank fallback)
SEMANTIC_SCHOLAR_API_KEY=""
ARXIV_MCP_SERVER_URL=http://localhost:8000/mcp/arxiv
RESEARCH_REQUEST_TIMEOUT=12
ENABLE_OFFLINE_PAPER_BANK=true

# AutoML run control
AUTOML_MAX_ITERATIONS=12
AUTOML_DEFAULT_MAX_ROWS=50000
AUTOML_DEFAULT_METRIC=accuracy
AUTOML_DEFAULT_TARGET_VALUE=0.85
AUTOML_METRIC_DIRECTION=maximize
AUTOML_FEATURE_ENGINEERING_EVERY_N=2
AUTOML_TEST_SIZE=0.2
AUTOML_MODEL_TIME_BUDGET=45

# Data platform connectors (optional; only used when credentials exist)
KAGGLE_USERNAME=""
KAGGLE_KEY=""
HUGGINGFACE_TOKEN=""

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json